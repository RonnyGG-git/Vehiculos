        {
          "name": "Crear marca Toyota (201, o 409 si ya existe)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/marcas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "marcas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Toyota\",\n  \"paisOrigen\": \"Japón\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201 o 409\", () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar marcas (toma el id de Toyota)",
          "request": {
            "method": "GET",
            "header": [],
