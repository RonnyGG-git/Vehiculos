          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200 OK\", () => pm.response.to.have.status(200));",
                  "const toyota = pm.response.json().find(m => m.nombre.toLowerCase() === \"toyota\");",
                  "pm.test(\"Existe la marca Toyota\", () => pm.expect(toyota).to.not.be.undefined);",
                  "pm.collectionVariables.set(\"marcaId\", toyota.id);"
