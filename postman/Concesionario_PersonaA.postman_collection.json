            "url": {
              "raw": "{{baseUrl}}/vehiculos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vehiculos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"{{placa}}\",\n  \"marcaId\": {{marcaId}},\n  \"modelo\": \"Corolla\",\n  \"anio\": 2024,\n  \"color\": \"Blanco\",\n  \"precio\": 95000000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const L = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\";",
                  "const r = () => L[Math.floor(Math.random() * 26)];",
                  "pm.collectionVariables.set(\"placa\", r() + r() + r() + String(Math.floor(Math.random() * 900) + 100));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201 Created\", () => pm.response.to.have.status(201));",
                  "const v = pm.response.json();",
                  "pm.test(\"Estado inicial DISPONIBLE\", () => pm.expect(v.estado).to.eql(\"DISPONIBLE\"));",
                  "pm.test(\"Devuelve el nombre de la marca\", () => pm.expect(v.marca).to.eql(\"Toyota\"));",
                  "pm.test(\"Incluye conversión COP -> USD\", () => {",
                  "  pm.expect(v.tasaCambioCopPorUsd).to.be.above(0);",
                  "  pm.expect(v.precioUsd).to.be.closeTo(v.precioCop / v.tasaCambioCopPorUsd, 0.01);",
                  "});",
                  "pm.collectionVariables.set(\"vehiculoId\", v.id);"
                ]
              }
            }
          ]
        },
