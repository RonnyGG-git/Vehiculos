{
  "info": {
    "name": "AutoDrive Motors - Persona B (Ventas y Mantenimientos)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Requisitos: app en {{baseUrl}} y datos de db/02-datos-prueba.sql cargados. Ejecutar en orden con el Collection Runner. Para repetir la corrida, volver a cargar db/02-datos-prueba.sql (las ventas cambian el estado de los vehiculos)."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Ventas",
      "item": [
        {
          "name": "1. Venta con descuento 5% (120M)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ventas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ventas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": 1,\n  \"vehiculoId\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"precioBase 120M\", () => pm.expect(j.precioBase).to.eql(120000000));",
                  "pm.test(\"descuento 6M\", () => pm.expect(j.descuento).to.eql(6000000));",
                  "pm.test(\"total 114M\", () => pm.expect(j.total).to.eql(114000000));",
                  "pm.test(\"fecha generada\", () => pm.expect(j.fechaVenta).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
