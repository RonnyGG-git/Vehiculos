<mxfile host="app.diagrams.net" type="device"><diagram id="cu" name="1. Diagrama de casos de uso"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cu-1" value="&lt;b&gt;Diagrama de casos de uso – Módulos Clientes y Vehículos&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Sistema de gestión de concesionario · Persona A&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="50" as="geometry"/></mxCell><mxCell id="cu-2" value="&lt;b&gt;Sistema de Concesionario&lt;/b&gt;&lt;br&gt;(Módulos Clientes y Vehículos)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1F4E79;strokeWidth=2;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="220" y="80" width="640" height="930" as="geometry"/></mxCell><mxCell id="cu-3" value="Asesor / Administrador&lt;br&gt;del concesionario" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="80" y="500" width="40" height="80" as="geometry"/></mxCell><mxCell id="cu-4" value="API externa de&lt;br&gt;tasa de cambio" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="960" y="780" width="40" height="80" as="geometry"/></mxCell><mxCell id="cu-5" value="CU-01 Registrar cliente" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="140" width="210" height="62" as="geometry"/></mxCell><mxCell id="cu-6" value="CU-02 Consultar clientes" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="222" width="210" height="62" as="geometry"/></mxCell><mxCell id="cu-7" value="CU-03 Actualizar cliente" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="304" width="210" height="62" as="geometry"/></mxCell><mxCell id="cu-8" value="CU-04 Eliminar cliente" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="386" width="210" height="62" as="geometry"/></mxCell><mxCell id="cu-9" value="CU-05 Registrar vehículo" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="508" width="210" height="62" as="geometry"/></mxCell><mxCell id="cu-10" value="CU-06 Consultar vehículos" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="590" width="210" height="62" as="geometry"/></mxCell><mxCell id="cu-11" value="CU-07 Actualizar vehículo" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="672" width="210" height="62" as="geometry"/></mxCell><mxCell id="cu-12" value="CU-08 Eliminar vehículo" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="754" width="210" height="62" as="geometry"/></mxCell><mxCell id="cu-13" value="CU-09 Consultar vehículos disponibles" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="836" width="210" height="62" as="geometry"/></mxCell><mxCell id="cu-14" value="CU-10 Buscar vehículos por marca" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="918" width="210" height="62" as="geometry"/></mxCell><mxCell id="cu-15" value="&lt;i&gt;Clientes&lt;/i&gt;" style="text;html=1;fontSize=11;fontColor=#7F7F7F;" vertex="1" parent="1"><mxGeometry x="230" y="120" width="80" height="20" as="geometry"/></mxCell><mxCell id="cu-16" value="&lt;i&gt;Vehículos&lt;/i&gt;" style="text;html=1;fontSize=11;fontColor=#7F7F7F;" vertex="1" parent="1"><mxGeometry x="230" y="490" width="80" height="20" as="geometry"/></mxCell><mxCell id="cu-17" value="CU-11 Validar correo único" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="210" width="200" height="62" as="geometry"/></mxCell><mxCell id="cu-18" value="CU-12 Validar placa única" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="570" width="200" height="62" as="geometry"/></mxCell><mxCell id="cu-19" value="CU-13 Convertir precio COP → USD" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="790" width="200" height="62" as="geometry"/></mxCell><mxCell id="cu-20" value="" style="endArrow=none;html=1;strokeColor=#404040;" edge="1" parent="1" source="cu-3" target="cu-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cu-21" value="" style="endArrow=none;html=1;strokeColor=#404040;" edge="1" parent="1" source="cu-3" target="cu-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cu-22" value="" style="endArrow=none;html=1;strokeColor=#404040;" edge="1" parent="1" source="cu-3" target="cu-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cu-23" value="" style="endArrow=none;html=1;strokeColor=#404040;" edge="1" parent="1" source="cu-3" target="cu-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cu-24" value="" style="endArrow=none;html=1;strokeColor=#404040;" edge="1" parent="1" source="cu-3" target="cu-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cu-25" value="" style="endArrow=none;html=1;strokeColor=#404040;" edge="1" parent="1" source="cu-3" target="cu-10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cu-26" value="" style="endArrow=none;html=1;strokeColor=#404040;" edge="1" parent="1" source="cu-3" target="cu-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cu-27" value="" style="endArrow=none;html=1;strokeColor=#404040;" edge="1" parent="1" source="cu-3" target="cu-12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cu-28" value="" style="endArrow=none;html=1;strokeColor=#404040;" edge="1" parent="1" source="cu-3" target="cu-13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cu-29" value="" style="endArrow=none;html=1;strokeColor=#404040;" edge="1" parent="1" source="cu-3" target="cu-14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cu-30" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#B85450;fontSize=10;" edge="1" parent="1" source="cu-5" target="cu-17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cu-31" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#B85450;fontSize=10;" edge="1" parent="1" source="cu-7" target="cu-17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cu-32" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#B85450;fontSize=10;" edge="1" parent="1" source="cu-9" target="cu-18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cu-33" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#B85450;fontSize=10;" edge="1" parent="1" source="cu-11" target="cu-18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cu-34" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#B85450;fontSize=10;" edge="1" parent="1" source="cu-10" target="cu-19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cu-35" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#B85450;fontSize=10;" edge="1" parent="1" source="cu-13" target="cu-19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cu-36" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#B85450;fontSize=10;" edge="1" parent="1" source="cu-14" target="cu-19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cu-37" value="" style="endArrow=none;html=1;strokeColor=#404040;" edge="1" parent="1" source="cu-19" target="cu-4"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="esp" name="2. Especificación de casos de uso"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="esp-1" value="&lt;b&gt;Especificación de casos de uso&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Actor principal en todos: Asesor / Administrador&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="50" as="geometry"/></mxCell><mxCell id="esp-2" value="&lt;b&gt;ID&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="70" height="32" as="geometry"/></mxCell><mxCell id="esp-3" value="&lt;b&gt;Caso de uso&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="80" width="150" height="32" as="geometry"/></mxCell><mxCell id="esp-4" value="&lt;b&gt;Descripción&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="80" width="230" height="32" as="geometry"/></mxCell><mxCell id="esp-5" value="&lt;b&gt;Precondición&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="80" width="170" height="32" as="geometry"/></mxCell><mxCell id="esp-6" value="&lt;b&gt;Flujo principal&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="80" width="330" height="32" as="geometry"/></mxCell><mxCell id="esp-7" value="&lt;b&gt;Flujos alternos / excepciones&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="990" y="80" width="290" height="32" as="geometry"/></mxCell><mxCell id="esp-8" value="&lt;b&gt;Postcondición&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1280" y="80" width="180" height="32" as="geometry"/></mxCell><mxCell id="esp-9" value="CU-01" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="70" height="89" as="geometry"/></mxCell><mxCell id="esp-10" value="Registrar cliente" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="110" y="112" width="150" height="89" as="geometry"/></mxCell><mxCell id="esp-11" value="Registra un nuevo cliente con nombre, documento, correo, teléfono y dirección." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="112" width="230" height="89" as="geometry"/></mxCell><mxCell id="esp-12" value="El correo no está registrado." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="112" width="170" height="89" as="geometry"/></mxCell><mxCell id="esp-13" value="1. Envía POST /clientes con los datos.&lt;br&gt;2. El sistema valida formato (RF-18).&lt;br&gt;3. Verifica correo único (CU-11).&lt;br&gt;4. Guarda el cliente.&lt;br&gt;5. Responde 201 con el cliente creado." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="112" width="330" height="89" as="geometry"/></mxCell><mxCell id="esp-14" value="A1. Datos inválidos → 400 con errores por campo.&lt;br&gt;A2. Correo repetido → 409." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="112" width="290" height="89" as="geometry"/></mxCell><mxCell id="esp-15" value="Cliente almacenado en la base de datos." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="112" width="180" height="89" as="geometry"/></mxCell><mxCell id="esp-16" value="CU-02" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="201" width="70" height="59" as="geometry"/></mxCell><mxCell id="esp-17" value="Consultar clientes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="110" y="201" width="150" height="59" as="geometry"/></mxCell><mxCell id="esp-18" value="Lista todos los clientes o consulta uno por su id." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="201" width="230" height="59" as="geometry"/></mxCell><mxCell id="esp-19" value="Ninguna." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="201" width="170" height="59" as="geometry"/></mxCell><mxCell id="esp-20" value="1. Envía GET /clientes o GET /clientes/{id}.&lt;br&gt;2. El sistema busca la información.&lt;br&gt;3. Responde 200 con la lista o el cliente." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="201" width="330" height="59" as="geometry"/></mxCell><mxCell id="esp-21" value="A1. Id inexistente → 404.&lt;br&gt;A2. Id no numérico → 400." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="201" width="290" height="59" as="geometry"/></mxCell><mxCell id="esp-22" value="Ninguna (solo lectura)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="201" width="180" height="59" as="geometry"/></mxCell><mxCell id="esp-23" value="CU-03" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="70" height="89" as="geometry"/></mxCell><mxCell id="esp-24" value="Actualizar cliente" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="110" y="260" width="150" height="89" as="geometry"/></mxCell><mxCell id="esp-25" value="Modifica los datos de un cliente existente." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="260" width="230" height="89" as="geometry"/></mxCell><mxCell id="esp-26" value="El cliente existe." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="260" width="170" height="89" as="geometry"/></mxCell><mxCell id="esp-27" value="1. Envía PUT /clientes/{id}.&lt;br&gt;2. Valida formato.&lt;br&gt;3. Verifica que el correo no pertenezca a otro cliente (CU-11).&lt;br&gt;4. Guarda cambios y responde 200." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="260" width="330" height="89" as="geometry"/></mxCell><mxCell id="esp-28" value="A1. Id inexistente → 404.&lt;br&gt;A2. Datos inválidos → 400.&lt;br&gt;A3. Correo de otro cliente → 409." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="260" width="290" height="89" as="geometry"/></mxCell><mxCell id="esp-29" value="Cliente actualizado." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="260" width="180" height="89" as="geometry"/></mxCell><mxCell id="esp-30" value="CU-04" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="349" width="70" height="59" as="geometry"/></mxCell><mxCell id="esp-31" value="Eliminar cliente" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="110" y="349" width="150" height="59" as="geometry"/></mxCell><mxCell id="esp-32" value="Elimina un cliente del sistema." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="349" width="230" height="59" as="geometry"/></mxCell><mxCell id="esp-33" value="El cliente existe." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="349" width="170" height="59" as="geometry"/></mxCell><mxCell id="esp-34" value="1. Envía DELETE /clientes/{id}.&lt;br&gt;2. El sistema elimina el registro.&lt;br&gt;3. Responde 204." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="349" width="330" height="59" as="geometry"/></mxCell><mxCell id="esp-35" value="A1. Id inexistente → 404." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="349" width="290" height="59" as="geometry"/></mxCell><mxCell id="esp-36" value="Cliente eliminado." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="349" width="180" height="59" as="geometry"/></mxCell><mxCell id="esp-37" value="CU-05" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="408" width="70" height="89" as="geometry"/></mxCell><mxCell id="esp-38" value="Registrar vehículo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="110" y="408" width="150" height="89" as="geometry"/></mxCell><mxCell id="esp-39" value="Registra un vehículo con placa, marca, modelo, año, color y precio en COP." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="408" width="230" height="89" as="geometry"/></mxCell><mxCell id="esp-40" value="La placa no está registrada." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="408" width="170" height="89" as="geometry"/></mxCell><mxCell id="esp-41" value="1. Envía POST /vehiculos.&lt;br&gt;2. Valida formato de placa y precio no negativo.&lt;br&gt;3. Verifica placa única (CU-12).&lt;br&gt;4. Guarda con estado DISPONIBLE.&lt;br&gt;5. Responde 201 con precio en COP y USD." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="408" width="330" height="89" as="geometry"/></mxCell><mxCell id="esp-42" value="A1. Precio negativo o datos inválidos → 400.&lt;br&gt;A2. Placa repetida → 409." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="408" width="290" height="89" as="geometry"/></mxCell><mxCell id="esp-43" value="Vehículo almacenado con estado DISPONIBLE." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="408" width="180" height="89" as="geometry"/></mxCell><mxCell id="esp-44" value="CU-06" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="497" width="70" height="59" as="geometry"/></mxCell><mxCell id="esp-45" value="Consultar vehículos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="110" y="497" width="150" height="59" as="geometry"/></mxCell><mxCell id="esp-46" value="Lista todos los vehículos o consulta uno por id, con precio en COP y USD." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="497" width="230" height="59" as="geometry"/></mxCell><mxCell id="esp-47" value="Ninguna." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="497" width="170" height="59" as="geometry"/></mxCell><mxCell id="esp-48" value="1. Envía GET /vehiculos o GET /vehiculos/{id}.&lt;br&gt;2. Obtiene la tasa de cambio (CU-13).&lt;br&gt;3. Responde 200 con precioCop, precioUsd y tasa." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="497" width="330" height="59" as="geometry"/></mxCell><mxCell id="esp-49" value="A1. Id inexistente → 404.&lt;br&gt;A2. API externa no responde → usa última tasa o tasa de respaldo." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="497" width="290" height="59" as="geometry"/></mxCell><mxCell id="esp-50" value="Ninguna (solo lectura)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="497" width="180" height="59" as="geometry"/></mxCell><mxCell id="esp-51" value="CU-07" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="556" width="70" height="89" as="geometry"/></mxCell><mxCell id="esp-52" value="Actualizar vehículo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="110" y="556" width="150" height="89" as="geometry"/></mxCell><mxCell id="esp-53" value="Modifica los datos de un vehículo existente." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="556" width="230" height="89" as="geometry"/></mxCell><mxCell id="esp-54" value="El vehículo existe." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="556" width="170" height="89" as="geometry"/></mxCell><mxCell id="esp-55" value="1. Envía PUT /vehiculos/{id}.&lt;br&gt;2. Valida datos y precio no negativo.&lt;br&gt;3. Verifica que la placa no pertenezca a otro vehículo (CU-12).&lt;br&gt;4. Guarda y responde 200." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="556" width="330" height="89" as="geometry"/></mxCell><mxCell id="esp-56" value="A1. Id inexistente → 404.&lt;br&gt;A2. Datos inválidos → 400.&lt;br&gt;A3. Placa de otro vehículo → 409." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="556" width="290" height="89" as="geometry"/></mxCell><mxCell id="esp-57" value="Vehículo actualizado (el estado no cambia)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="556" width="180" height="89" as="geometry"/></mxCell><mxCell id="esp-58" value="CU-08" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="645" width="70" height="59" as="geometry"/></mxCell><mxCell id="esp-59" value="Eliminar vehículo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="110" y="645" width="150" height="59" as="geometry"/></mxCell><mxCell id="esp-60" value="Elimina un vehículo del inventario." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="645" width="230" height="59" as="geometry"/></mxCell><mxCell id="esp-61" value="El vehículo existe." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="645" width="170" height="59" as="geometry"/></mxCell><mxCell id="esp-62" value="1. Envía DELETE /vehiculos/{id}.&lt;br&gt;2. Elimina el registro.&lt;br&gt;3. Responde 204." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="645" width="330" height="59" as="geometry"/></mxCell><mxCell id="esp-63" value="A1. Id inexistente → 404." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="645" width="290" height="59" as="geometry"/></mxCell><mxCell id="esp-64" value="Vehículo eliminado." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="645" width="180" height="59" as="geometry"/></mxCell><mxCell id="esp-65" value="CU-09" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="704" width="70" height="74" as="geometry"/></mxCell><mxCell id="esp-66" value="Consultar vehículos disponibles" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="110" y="704" width="150" height="74" as="geometry"/></mxCell><mxCell id="esp-67" value="Lista solo los vehículos en estado DISPONIBLE." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="704" width="230" height="74" as="geometry"/></mxCell><mxCell id="esp-68" value="Ninguna." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="704" width="170" height="74" as="geometry"/></mxCell><mxCell id="esp-69" value="1. Envía GET /vehiculos/disponibles.&lt;br&gt;2. Filtra por estado DISPONIBLE.&lt;br&gt;3. Convierte precios (CU-13).&lt;br&gt;4. Responde 200." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="704" width="330" height="74" as="geometry"/></mxCell><mxCell id="esp-70" value="A1. No hay disponibles → 200 con lista vacía." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="704" width="290" height="74" as="geometry"/></mxCell><mxCell id="esp-71" value="Ninguna (solo lectura)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="704" width="180" height="74" as="geometry"/></mxCell><mxCell id="esp-72" value="CU-10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="778" width="70" height="74" as="geometry"/></mxCell><mxCell id="esp-73" value="Buscar vehículos por marca" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="110" y="778" width="150" height="74" as="geometry"/></mxCell><mxCell id="esp-74" value="Lista los vehículos de una marca sin distinguir mayúsculas." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="778" width="230" height="74" as="geometry"/></mxCell><mxCell id="esp-75" value="Ninguna." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="778" width="170" height="74" as="geometry"/></mxCell><mxCell id="esp-76" value="1. Envía GET /vehiculos/marca/{marca}.&lt;br&gt;2. Filtra por marca.&lt;br&gt;3. Convierte precios (CU-13).&lt;br&gt;4. Responde 200." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="778" width="330" height="74" as="geometry"/></mxCell><mxCell id="esp-77" value="A1. Marca sin vehículos → 200 con lista vacía." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="778" width="290" height="74" as="geometry"/></mxCell><mxCell id="esp-78" value="Ninguna (solo lectura)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="778" width="180" height="74" as="geometry"/></mxCell><mxCell id="esp-79" value="CU-11" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="852" width="70" height="59" as="geometry"/></mxCell><mxCell id="esp-80" value="Validar correo único" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="110" y="852" width="150" height="59" as="geometry"/></mxCell><mxCell id="esp-81" value="Caso incluido: verifica que el correo no exista en otro cliente." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="852" width="230" height="59" as="geometry"/></mxCell><mxCell id="esp-82" value="Llamado desde CU-01 o CU-03." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="852" width="170" height="59" as="geometry"/></mxCell><mxCell id="esp-83" value="1. Normaliza el correo a minúsculas.&lt;br&gt;2. Consulta si existe.&lt;br&gt;3. Si no existe, continúa." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="852" width="330" height="59" as="geometry"/></mxCell><mxCell id="esp-84" value="A1. Existe → 409 Conflict." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="852" width="290" height="59" as="geometry"/></mxCell><mxCell id="esp-85" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="852" width="180" height="59" as="geometry"/></mxCell><mxCell id="esp-86" value="CU-12" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="911" width="70" height="59" as="geometry"/></mxCell><mxCell id="esp-87" value="Validar placa única" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="110" y="911" width="150" height="59" as="geometry"/></mxCell><mxCell id="esp-88" value="Caso incluido: verifica que la placa no exista en otro vehículo." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="911" width="230" height="59" as="geometry"/></mxCell><mxCell id="esp-89" value="Llamado desde CU-05 o CU-07." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="911" width="170" height="59" as="geometry"/></mxCell><mxCell id="esp-90" value="1. Normaliza la placa a mayúsculas y sin guion.&lt;br&gt;2. Consulta si existe.&lt;br&gt;3. Si no existe, continúa." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="911" width="330" height="59" as="geometry"/></mxCell><mxCell id="esp-91" value="A1. Existe → 409 Conflict." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="911" width="290" height="59" as="geometry"/></mxCell><mxCell id="esp-92" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="911" width="180" height="59" as="geometry"/></mxCell><mxCell id="esp-93" value="CU-13" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="70" height="74" as="geometry"/></mxCell><mxCell id="esp-94" value="Convertir precio COP → USD" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="110" y="970" width="150" height="74" as="geometry"/></mxCell><mxCell id="esp-95" value="Caso incluido: obtiene la tasa de la API externa y calcula el precio en dólares." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="970" width="230" height="74" as="geometry"/></mxCell><mxCell id="esp-96" value="Llamado desde CU-06, CU-09 o CU-10." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="970" width="170" height="74" as="geometry"/></mxCell><mxCell id="esp-97" value="1. Si hay tasa en caché vigente (60 min), la usa.&lt;br&gt;2. Si no, consulta la API externa.&lt;br&gt;3. Calcula precioUsd = precioCop / tasa (2 decimales)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="970" width="330" height="74" as="geometry"/></mxCell><mxCell id="esp-98" value="A1. La API falla o tarda más de 5 s → usa la última tasa conocida o el valor de respaldo configurado." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="970" width="290" height="74" as="geometry"/></mxCell><mxCell id="esp-99" value="Tasa guardada en caché." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="970" width="180" height="74" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rf" name="3. Requerimientos funcionales"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rf-1" value="&lt;b&gt;Requerimientos funcionales – Módulos Clientes y Vehículos&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="50" as="geometry"/></mxCell><mxCell id="rf-2" value="&lt;b&gt;ID&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="80" height="32" as="geometry"/></mxCell><mxCell id="rf-3" value="&lt;b&gt;Requerimie