ell><mxCell id="rf-116" value="RF-19" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="769" width="80" height="44" as="geometry"/></mxCell><mxCell id="rf-117" value="Estado del vehículo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="769" width="220" height="44" as="geometry"/></mxCell><mxCell id="rf-118" value="El sistema debe ofrecer al módulo de Ventas y Mantenimientos una operación para cambiar el estado del vehículo (DISPONIBLE, VENDIDO, EN_MANTENIMIENTO)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="769" width="560" height="44" as="geometry"/></mxCell><mxCell id="rf-119" value="Alta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="769" width="90" height="44" as="geometry"/></mxCell><mxCell id="rf-120" value="(interno)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="769" width="210" height="44" as="geometry"/></mxCell><mxCell id="rf-121" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="769" width="80" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rnf" name="4. Requerimientos no funcionales"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rnf-1" value="&lt;b&gt;Requerimientos no funcionales – Módulos Clientes y Vehículos&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="50" as="geometry"/></mxCell><mxCell id="rnf-2" value="&lt;b&gt;ID&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="80" height="32" as="geometry"/></mxCell><mxCell id="rnf-3" value="&lt;b&gt;Categoría&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="80" width="150" height="32" as="geometry"/></mxCell><mxCell id="rnf-4" value="&lt;b&gt;Requerimiento&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="80" width="420" height="32" as="geometry"/></mxCell><mxCell id="rnf-5" value="&lt;b&gt;Criterio de aceptación&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;fontColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="80" width="470" height="32" as="geometry"/></mxCell><mxCell id="rnf-6" value="RNF-01" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="80" height="44" as="geometry"/></mxCell><mxCell id="rnf-7" value="Rendimiento" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="112" width="150" height="44" as="geometry"/></mxCell><mxCell id="rnf-8" value="Las consultas deben responder rápidamente." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="112" width="420" height="44" as="geometry"/></mxCell><mxCell id="rnf-9" value="Tiempo de respuesta menor a 2 segundos en consultas con la tasa en caché." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690" y="112" width="470" height="44" as="geometry"/></mxCell><mxCell id="rnf-10" value="RNF-02" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="156" width="80" height="44" as="geometry"/></mxCell><mxCell id="rnf-11" value="Tolerancia a fallos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="156" width="150" height="44" as="geometry"/></mxCell><mxCell id="rnf-12" value="Una caída de la API externa no debe impedir consultar vehículos." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="156" width="420" height="44" as="geometry"/></mxCell><mxCell id="rnf-13" value="Si la API falla o tarda más de 5 s, se usa la última tasa conocida o la tasa de respaldo y la respuesta es 200." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690" y="156" width="470" height="44" as="geometry"/></mxCell><mxCell id="rnf-14" value="RNF-03" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="80" height="29" as="geometry"/></mxCell><mxCell id="rnf-15" value="Eficiencia" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="200" width="150" height="29" as="geometry"/></mxCell><mxCell id="rnf-16" value="Se debe limitar el número de llamadas a la API externa." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="200" width="420" height="29" as="geometry"/></mxCell><mxCell id="rnf-17" value="La tasa se guarda en caché durante 60 minutos." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690" y="200" width="470" height="29" as="geometry"/></mxCell><mxCell id="rnf-18" value="RNF-04" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="229" width="80" height="44" as="geometry"/></mxCell><mxCell id="rnf-19" value="Integridad de datos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="229" width="150" height="44" as="geometry"/></mxCell><mxCell id="rnf-20" value="Las reglas de unicidad deben protegerse también en la base de datos." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="229" width="420" height="44" as="geometry"/></mxCell><mxCell id="rnf-21" value="Restricciones UNIQUE en las columnas placa y correo." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690" y="229" width="470" height="44" as="geometry"/></mxCell><mxCell id="rnf-22" value="RNF-05" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="273" width="80" height="29" as="geometry"/></mxCell><mxCell id="rnf-23" value="Interoperabilidad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="273" width="150" height="29" as="geometry"/></mxCell><mxCell id="rnf-24" value="La API debe seguir el estilo REST con JSON." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="273" width="420" height="29" as="geometry"/></mxCell><mxCell id="rnf-25" value="Uso de códigos HTTP estándar: 200, 201, 204, 400, 404 y 409." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690" y="273" width="470" height="29" as="geometry"/></mxCell><mxCell id="rnf-26" value="RNF-06" style="rounded=0;whiteSpace=wrap;html=1;fillCol