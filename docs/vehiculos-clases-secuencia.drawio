=11;dashed=1;endArrow=open;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="280" as="sourcePoint"/><mxPoint x="550" y="280" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m6" value="findByIdForUpdate(vehiculoId)  [bloqueo]" style="html=1;verticalAlign=bottom;strokeColor=#1E293B;fontSize=11;endArrow=block;endFill=1;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="330" as="sourcePoint"/><mxPoint x="770" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m7" value="Vehiculo" style="html=1;verticalAlign=bottom;strokeColor=#1E293B;fontSize=11;dashed=1;endArrow=open;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="360" as="sourcePoint"/><mxPoint x="550" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t8" value="estado == DISPONIBLE y precio != null" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FEF3C7;strokeColor=#B45309;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="395" y="395" width="240" height="40" as="geometry"/></mxCell><mxCell id="t9" value="descuento = precio &gt; 100.000.000 ? 5% : 0&lt;br&gt;total = precio − descuento&lt;br&gt;fechaVenta = now()" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#FEF3C7;strokeColor=#B45309;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="395" y="450" width="240" height="60" as="geometry"/></mxCell><mxCell id="m10" value="save(venta)  +  vehiculo.estado = VENDIDO" style="html=1;verticalAlign=bottom;strokeColor=#1E293B;fontSize=11;endArrow=block;endFill=1;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="560" as="sourcePoint"/><mxPoint x="770" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m11" value="Venta guardada (commit)" style="html=1;verticalAlign=bottom;strokeColor=#1E293B;fontSize=11;dashed=1;endArrow=open;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="590" as="sourcePoint"/><mxPoint x="550" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m12" value="VentaResponse" style="html=1;verticalAlign=bottom;strokeColor=#1E293B;fontSize=11;dashed=1;endArrow=open;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="640" as="sourcePoint"/><mxPoint x="330" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m13" value="201 Created {id, fechaVenta, descuento, total}" style="html=1;verticalAlign=bottom;strokeColor=#1E293B;fontSize=11;dashed=1;endArrow=open;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="690" as="sourcePoint"/><mxPoint x="110" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t14" value="&lt;b&gt;Flujos de error&lt;/b&gt;&lt;br&gt;Cliente o vehículo inexistente → RecursoNoEncontradoException → 404&lt;br&gt;Vehículo VENDIDO o EN_MANTENIMIENTO → VehiculoNoDisponibleException → 409&lt;br&gt;Sin precio → BusinessException → 409&lt;br&gt;Body inválido → 400 con details[]&lt;br&gt;Todas las excepciones las convierte GlobalExceptionHandler al JSON de error estándar." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;spacing=8;fontSize=12;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="700" y="740" width="460" height="120" as="geometry"/></mxCell><mxCell id="t15" value="Si ocurre una excepción dentro de registrar(), la transacción se revierte: el vehículo no cambia de estado y no se crea la venta." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;spacing=8;fontSize=12;fontColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="600" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>