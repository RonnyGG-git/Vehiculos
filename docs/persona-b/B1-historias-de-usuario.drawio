<mxfile host="claude-code" version="24.0.0"><diagram id="hu" name="Historias de usuario"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="960" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Historias de Usuario — Persona B (Ventas + Mantenimientos)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;fontStyle=1;strokeColor=none;fillColor=none;fontSize=20;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1000" height="30" as="geometry"/></mxCell><mxCell id="subtitle" value="AutoDrive Motors · Formato: Como … quiero … para …  +  criterios Dado / Cuando / Entonces · ✅ implementada · 📋 propuesta" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=12;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="45" width="1200" height="20" as="geometry"/></mxCell><mxCell id="h_v" value="Ventas" style="rounded=1;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;fillColor=#1D4ED8;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="390" height="36" as="geometry"/></mxCell><mxCell id="h_m" value="Mantenimientos" style="rounded=1;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;fillColor=#047857;strokeColor=#047857;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="450" y="80" width="390" height="36" as="geometry"/></mxCell><mxCell id="h_t" value="Transversal y trazabilidad" style="rounded=1;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;fillColor=#6D28D9;strokeColor=#6D28D9;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="870" y="80" width="390" height="36" as="geometry"/></mxCell><mxCell id="v01" value="&lt;b&gt;HU-V01&lt;/b&gt; — Registrar una venta ✅" style="swimlane;html=1;startSize=32;collapsible=0;fontStyle=0;fontSize=13;align=left;spacingLeft=10;fillColor=#DBEAFE;strokeColor=#1D4ED8;rounded=1;arcSize=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="390" height="200" as="geometry"/></mxCell><mxCell id="v01_b" value="&lt;b&gt;Como&lt;/b&gt; vendedor &lt;b&gt;quiero&lt;/b&gt; registrar la venta de un vehículo a un cliente &lt;b&gt;para&lt;/b&gt; dejar constancia y evitar ventas duplicadas.&lt;br&gt;&lt;br&gt;&lt;b&gt;Criterios de aceptación&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Dado&lt;/b&gt; un cliente y un vehículo DISPONIBLE, &lt;b&gt;cuando&lt;/b&gt; envío POST /ventas {clienteId, vehiculoId}, &lt;b&gt;entonces&lt;/b&gt; se crea la venta (201) con fecha y total calculados por el sistema.&lt;br&gt;• &lt;b&gt;Y&lt;/b&gt; el vehículo queda en estado VENDIDO.&lt;br&gt;• &lt;b&gt;Dado&lt;/b&gt; que falta clienteId o vehiculoId → 400 con el campo en details.&lt;br&gt;• &lt;b&gt;Dado&lt;/b&gt; un cliente o vehículo inexistente → 404.&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="v01"><mxGeometry x="0" y="32" width="390" height="168" as="geometry"/></mxCell><mxCell id="v02" value="&lt;b&gt;HU-V02&lt;/b&gt; — Descuento automático del 5 % ✅" style="swimlane;html=1;startSize=32;collapsible=0;fontStyle=0;fontSize=13;align=left;spacingLeft=10;fillColor=#DBEAFE;strokeColor=#1D4ED8;rounded=1;arcSize=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="350" width="390" height="190" as="geometry"/></mxCell><mxCell id="v02_b" value="&lt;b&gt;Como&lt;/b&gt; gerente &lt;b&gt;quiero&lt;/b&gt; que las ventas de vehículos caros reciban un descuento automático &lt;b&gt;para&lt;/b&gt; aplicar la política comercial sin errores manuales.&lt;br&gt;&lt;br&gt;&lt;b&gt;Criterios de aceptación&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Dado&lt;/b&gt; un vehículo de $120.000.000 → descuento $6.000.000 y total $114.000.000.&lt;br&gt;• &lt;b&gt;Dado&lt;/b&gt; un vehículo de exactamente $100.000.000 (o menos) → descuento 0 y total = precio.&lt;br&gt;• La respuesta incluye precioBase, descuento y total.&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="v02"><mxGeometry x="0" y="32" width="390" height="158" as="geometry"/></mxCell><mxCell id="v03" value="&lt;b&gt;HU-V03&lt;/b&gt; — Impedir vender un vehículo no disponible ✅" style="swimlane;html=1;startSize=32;collapsible=0;fontStyle=0;fontSize=13;align=left;spacingLeft=10;fillColor=#DBEAFE;strokeColor=#1D4ED8;rounded=1;arcSize=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="560" width="390" height="200" as="geometry"/></mxCell><mxCell id="v03_b" value="&lt;b&gt;Como&lt;/b&gt; vendedor &lt;b&gt;quiero&lt;/b&gt; que el sistema rechace la venta de un vehículo vendido o en mantenimiento &lt;b&gt;para&lt;/b&gt; no vender algo que no se puede entregar.&lt;br&gt;&lt;br&gt;&lt;b&gt;Criterios de aceptación&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Dado&lt;/b&gt; un vehículo VENDIDO o EN_MANTENIMIENTO, &lt;b&gt;cuando&lt;/b&gt; intento venderlo, &lt;b&gt;entonces&lt;/b&gt; recibo 409 con el estado actual y no se crea la venta.&lt;br&gt;• &lt;b&gt;Dado&lt;/b&gt; un vehículo sin precio → 409.&lt;br&gt;• &lt;b&gt;Dado&lt;/b&gt; dos ventas simultáneas del mismo vehículo → solo una se completa.&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="v03"><mxGeometry x="0" y="32" width="390" height="168" as="geometry"/></mxCell><mxCell id="v04" value="&lt;b&gt;HU-V04&lt;/b&gt; — Consultar ventas ✅" style="swimlane;html=1;startSize=32;collapsible=0;fontStyle=0;fontSize=13;align=left;spacingLeft=10;fillColor=#DBEAFE;strokeColor=#1D4ED8;rounded=1;arcSize=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="780" width="390" height="130" as="geometry"/></mxCell><mxCell id="v04_b" value="&lt;b&gt;Como&lt;/b&gt; gerente &lt;b&gt;quiero&lt;/b&gt; listar las ventas &lt;b&gt;para&lt;/b&gt; controlar qué vehículos se vendieron, a quién y por cuánto.&lt;br&gt;&lt;br&gt;&lt;b&gt;Criterios de aceptación&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Cuando&lt;/b&gt; consulto GET /ventas, &lt;b&gt;entonces&lt;/b&gt; recibo todas las ventas con cliente, placa, fecha, precio base, descuento y total.&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="v04"><mxGeometry x="0" y="32" width="390" height="98" as="geometry"/></mxCell><mxCell id="m01" value="&lt;b&gt;HU-M01&lt;/b&gt; — Registrar un mantenimiento ✅" style="swimlane;html=1;startSize=32;collapsible=0;fontStyle=0;fontSize=13;align=left;spacingLeft=10;fillColor=#D1FAE5;strokeColor=#047857;rounded=1;arcSize=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="450" y="130" width="390" height="200" as="geometry"/></mxCell><mxCell id="m01_b" value="&lt;b&gt;Como&lt;/b&gt; jefe de taller &lt;b&gt;quiero&lt;/b&gt; registrar un mantenimiento a un vehículo &lt;b&gt;para&lt;/b&gt; mantener su historial y marcarlo como no disponible.&lt;br&gt;&lt;br&gt;&lt;b&gt;Criterios de aceptación&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Dado&lt;/b&gt; un vehículo que no está vendido, &lt;b&gt;cuando&lt;/b&gt; envío POST /mantenimientos {vehiculoId, descripcion, costo}, &lt;b&gt;entonces&lt;/b&gt; se crea (201) y el vehículo queda EN_MANTENIMIENTO.&lt;br&gt;• Si no envío fecha, se usa la fecha actual.&lt;br&gt;• &lt;b&gt;Dado&lt;/b&gt; descripción vacía o costo negativo → 400.&lt;br&gt;• &lt;b&gt;Dado&lt;/b&gt; un vehículo VENDIDO → 409 (📋 regla propia). Inexistente → 404.&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#047857;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="m01"><mxGeometry x="0" y="32" width="390" height="168" as="geometry"/></mxCell><mxCell id="m02" value="&lt;b&gt;HU-M02&lt;/b&gt; — Consultar el historial de un vehículo ✅" style="swimlane;html=1;startSize=32;collapsible=0;fontStyle=0;fontSize=13;align=left;spacingLeft=10;fillColor=#D1FAE5;strokeColor=#047857;rounded=1;arcSize=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="450" y="350" width="390" height="170" as="geometry"/></mxCell><mxCell id="m02_b" value="&lt;b&gt;Como&lt;/b&gt; jefe de taller o cliente &lt;b&gt;quiero&lt;/b&gt; ver el historial de mantenimientos de un vehículo &lt;b&gt;para&lt;/b&gt; conocer su estado y costos acumulados.&lt;br&gt;&lt;br&gt;&lt;b&gt;Criterios de aceptación&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Cuando&lt;/b&gt; consulto GET /mantenimientos/vehiculo/{id} → lista de sus mantenimientos.&lt;br&gt;• &lt;b&gt;Dado&lt;/b&gt; un vehículo sin mantenimientos → lista vacía (200).&lt;br&gt;• &lt;b&gt;Dado&lt;/b&gt; un vehículo inexistente → 404.&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#047857;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="m02"><mxGeometry x="0" y="32" width="390" height="138" as="geometry"/></mxCell><mxCell id="m03" value="&lt;b&gt;HU-M03&lt;/b&gt; — Consultar todos los mantenimientos ✅" style="swimlane;html=1;startSize=32;collapsible=0;fontStyle=0;fontSize=13;align=left;spacingLeft=10;fillColor=#D1FAE5;strokeColor=#047857;rounded=1;arcSize=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="450" y="540" width="390" height="130" as="geometry"/></mxCell><mxCell id="m03_b" value="&lt;b&gt;Como&lt;/b&gt; gerente &lt;b&gt;quiero&lt;/b&gt; listar todos los mantenimientos &lt;b&gt;para&lt;/b&gt; revisar la actividad del taller.&lt;br&gt;&lt;br&gt;&lt;b&gt;Criterios de aceptación&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Cuando&lt;/b&gt; consulto GET /mantenimientos → todos, con placa, fecha, descripción y costo.&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#047857;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="m03"><mxGeometry x="0" y="32" width="390" height="98" as="geometry"/></mxCell><mxCell id="m05" value="&lt;b&gt;HU-M05&lt;/b&gt; — Finalizar un mantenimiento 📋" style="swimlane;html=1;startSize=32;collapsible=0;fontStyle=0;fontSize=13;align=left;spacingLeft=10;fillColor=#FFFBEB;strokeColor=#B45309;rounded=1;arcSize=6;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="450" y="690" width="390" height="150" as="geometry"/></mxCell><mxCell id="m05_b" value="&lt;b&gt;Como&lt;/b&gt; jefe de taller &lt;b&gt;quiero&lt;/b&gt; marcar un mantenimiento como terminado &lt;b&gt;para&lt;/b&gt; que el vehículo vuelva a DISPONIBLE y se pueda vender.&lt;br&gt;&lt;br&gt;&lt;b&gt;Criterios de aceptación&lt;/b&gt;&lt;br&gt;• Propuesta, &lt;b&gt;no implementada&lt;/b&gt;: el enunciado no define cómo sale un vehículo de EN_MANTENIMIENTO.&lt;br&gt;• Confirmar con el docente / equipo.&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#B45309;fontSize=11;dashed=1;fontFamily=Helvetica;" vertex="1" parent="m05"><mxGeometry x="0" y="32" width="390" height="118" as="geometry"/></mxCell><mxCell id="t01" value="&lt;b&gt;HU-T01&lt;/b&gt; — Errores claros y uniformes ✅" style="swimlane;html=1;startSize=32;collapsible=0;fontStyle=0;fontSize=13;align=left;spacingLeft=10;fillColor=#EDE9FE;strokeColor=#6D28D9;rounded=1;arcSize=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="870" y="130" width="390" height="150" as="geometry"/></mxCell><mxCell id="t01_b" value="&lt;b&gt;Como&lt;/b&gt; consumidor de la API &lt;b&gt;quiero&lt;/b&gt; respuestas de error con un formato único &lt;b&gt;para&lt;/b&gt; manejarlas sin casos especiales.&lt;br&gt;&lt;br&gt;&lt;b&gt;Criterios de aceptación&lt;/b&gt;&lt;br&gt;• Todo error devuelve {timestamp, status, error, message, path, details[]}.&lt;br&gt;• Validación → 400 (un ítem por campo en details); inexistente → 404; regla de negocio → 409; error inesperado → 500 sin detalles internos.&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#6D28D9;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="t01"><mxGeometry x="0" y="32" width="390" height="118" as="geometry"/></mxCell><mxCell id="traz" value="&lt;b&gt;Trazabilidad con el enunciado&lt;/b&gt;&lt;br&gt;&lt;table style='width:100%;border-collapse:collapse;font-size:11px'&gt;&lt;tr&gt;&lt;td&gt;&lt;i&gt;Requerimiento&lt;/i&gt;&lt;/td&gt;&lt;td&gt;&lt;i&gt;HU&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px 6px;border-top:1px solid #CBD5E1'&gt;Registrar ventas / asociar cliente y vehículo&lt;/td&gt;&lt;td style='padding:3px 6px;border-top:1px solid #CBD5E1'&gt;&lt;b&gt;HU-V01&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px 6px;border-top:1px solid #CBD5E1'&gt;Calcular total de venta&lt;/td&gt;&lt;td style='padding:3px 6px;border-top:1px solid #CBD5E1'&gt;&lt;b&gt;HU-V01, V02&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px 6px;border-top:1px solid #CBD5E1'&gt;Cambiar el estado a «Vendido»&lt;/td&gt;&lt;td style='padding:3px 6px;border-top:1px solid #CBD5E1'&gt;&lt;b&gt;HU-V01&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px 6px;border-top:1px solid #CBD5E1'&gt;No vender vehículo vendido / en mantenimiento&lt;/td&gt;&lt;td style='padding:3px 6px;border-top:1px solid #CBD5E1'&gt;&lt;b&gt;HU-V03&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px 6px;border-top:1px solid #CBD5E1'&gt;Descuento 5 % sobre $100.000.000&lt;/td&gt;&lt;td style='padding:3px 6px;border-top:1px solid #CBD5E1'&gt;&lt;b&gt;HU-V02&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px 6px;border-top:1px solid #CBD5E1'&gt;Registrar mantenimientos + «En mantenimiento»&lt;/td&gt;&lt;td style='padding:3px 6px;border-top:1px solid #CBD5E1'&gt;&lt;b&gt;HU-M01&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px 6px;border-top:1px solid #CBD5E1'&gt;Consultar historial de mantenimientos&lt;/td&gt;&lt;td style='padding:3px 6px;border-top:1px solid #CBD5E1'&gt;&lt;b&gt;HU-M02, M03&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px 6px;border-top:1px solid #CBD5E1'&gt;Manejo de excepciones&lt;/td&gt;&lt;td style='padding:3px 6px;border-top:1px solid #CBD5E1'&gt;&lt;b&gt;HU-T01&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#6D28D9;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="870" y="300" width="390" height="225" as="geometry"/></mxCell><mxCell id="actores" value="&lt;b&gt;Actores&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Vendedor&lt;/b&gt;: registra ventas.&lt;br&gt;• &lt;b&gt;Jefe de taller / técnico&lt;/b&gt;: registra mantenimientos y consulta historiales.&lt;br&gt;• &lt;b&gt;Gerente&lt;/b&gt;: consulta ventas y mantenimientos." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="870" y="545" width="390" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="casos-uso" name="Actores e historias (casos de uso)"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="760" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Actores e historias de usuario — Persona B" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;fontStyle=1;strokeColor=none;fillColor=none;fontSize=20;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1000" height="30" as="geometry"/></mxCell><mxCell id="subtitle" value="Cada óvalo es una historia de usuario; «include» = paso obligatorio que el sistema hace dentro de otra" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=12;fontColor=#475569;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="45" width="1200" height="20" as="geometry"/></mxCell><mxCell id="sis" value="API AutoDrive Motors — Ventas y Mantenimientos" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=8;fillColor=#F8FAFC;strokeColor=#334155;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="230" y="80" width="760" height="640" as="geometry"/></mxCell><mxCell id="a_vend" value="Vendedor" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="40" height="80" as="geometry"/></mxCell><mxCell id="a_taller" value="Jefe de taller" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="460" width="40" height="80" as="geometry"/></mxCell><mxCell id="a_ger" value="Gerente" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1070" y="330" width="40" height="80" as="geometry"/></mxCell><mxCell id="uc_v01" value="&lt;b&gt;HU-V01&lt;/b&gt;&lt;br&gt;Registrar venta" style="ellipse;html=1;whiteSpace=wrap;fontSize=11;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="270" y="140" width="230" height="64" as="geometry"/></mxCell><mxCell id="uc_v03" value="&lt;b&gt;HU-V03&lt;/b&gt;&lt;br&gt;Validar que el vehículo&lt;br&gt;esté DISPONIBLE" style="ellipse;html=1;whiteSpace=wrap;fontSize=11;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="210" height="64" as="geometry"/></mxCell><mxCell id="uc_v02" value="&lt;b&gt;HU-V02&lt;/b&gt;&lt;br&gt;Calcular descuento 5 %" style="ellipse;html=1;whiteSpace=wrap;fontSize=11;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="520" y="200" width="210" height="64" as="geometry"/></mxCell><mxCell id="uc_est" value="Cambiar estado&lt;br&gt;del vehículo" style="ellipse;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FEF3C7;strokeColor=#B45309;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="520" y="330" width="210" height="64" as="geometry"/></mxCell><mxCell id="uc_v04" value="&lt;b&gt;HU-V04&lt;/b&gt;&lt;br&gt;Consultar ventas" style="ellipse;html=1;whiteSpace=wrap;fontSize=11;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="200" width="200" height="64" as="geometry"/></mxCell><mxCell id="uc_m01" value="&lt;b&gt;HU-M01&lt;/b&gt;&lt;br&gt;Registrar mantenimiento" style="ellipse;html=1;whiteSpace=wrap;fontSize=11;fillColor=#D1FAE5;strokeColor=#047857;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="270" y="430" width="230" height="64" as="geometry"/></mxCell><mxCell id="uc_m02" value="&lt;b&gt;HU-M02&lt;/b&gt;&lt;br&gt;Historial de un vehículo" style="ellipse;html=1;whiteSpace=wrap;fontSize=11;fillColor=#D1FAE5;strokeColor=#047857;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="270" y="530" width="230" height="64" as="geometry"/></mxCell><mxCel